# ========================================================
# Autoflex PCP — Configurações de Ambiente (Docker & Dev)
# ========================================================
# Copie este arquivo para .env antes de executar o docker-compose:
#   cp .env.example .env

# --- Banco de Dados PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_segura_aqui_123
POSTGRES_DB=autoflex_db
POSTGRES_LOCAL_PORT=127.0.0.1:5432

# --- Segurança & Autenticação JWT ---
# Chave secreta de no mínimo 256 bits para assinatura de tokens JWT
JWT_SECRET=autoflex-pcp-production-planning-secret-key-256-bits-minimum-length-key
JWT_EXPIRATION=86400000

# --- CORS & URLs Permitidas ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:3000
